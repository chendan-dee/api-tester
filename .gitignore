# ── 打包产物 ──
*.exe
build/
dist/

# ── 运行时生成目录 ──
transfer/
数据生成/
logs/

# ── Python 缓存 ──
__pycache__/
*.pyc
.pytest_cache/

# ── 运行时数据（唯一活跃数据目录为 data/，均为本地生成不入库）──
data/_*.json
cases/_*.json

# runtime data (local only)
data/config.json
data/settings.json
data/localdb/
data/thumbs/
data/capture_bodies/
data/_datasets/
data/_schedule_runs/
data/_schedule_params/
data/sql/
data/*.db
data/*.sqlite

# certificates / private keys - never commit
certs/

# 投屏子服务：依赖已随仓库分发（见文件末的例外），无需 npm install
node_modules/

# temp & verification artifacts
temps/
_verify_shots/
_tmp_*
_compat_*.db
*.bak

# ── 例外：投屏子服务把运行依赖一起入库，clone 下来直接可用 ──
# ws / hdckit（含 agent.so）及其依赖链；node_modules 目录本身也要先解除忽略，否则子项无法回加
!src/phone_mirror/node_modules/
!src/phone_mirror/node_modules/**
# hdc.exe（鸿蒙）、adb.exe + 两个 DLL（Android）、scrcpy-server.jar（H.264 采集）
!src/phone_mirror/tools/**

