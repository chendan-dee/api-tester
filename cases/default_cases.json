    {
      "name": "示例1 创建订单（提取）",
      "request": {
        "method": "POST",
        "url": "https://httpbin.org/post",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "orderNo": "${orderNo}",
          "sku": "SKU-9",
          "qty": 2
        },
        "timeout": 30
      },
      "assert": {
        "status_code": 200,
        "json_path": {
          "json.orderNo": "A20261105"
        }
      },
      "extract": {
        "orderNo": "json.orderNo",
        "clientIp": "origin"
      },
      "group": "提取示例"
    },
    {
      "name": "示例2 查询订单（引用）",
      "request": {
        "method": "GET",
        "url": "https://httpbin.org/get?order_no=%24%7BorderNo%7D",
        "headers": {
          "X-Order-No": "${orderNo}",
          "X-Client-Ip": "${clientIp}"
        },
        "timeout": 30
      },
      "assert": {
        "status_code": 200,
        "json_path": {
          "args.order_no": "A20261105"
        }
      },
      "group": "提取示例"
    },
    {
      "name": "示例3 列表提取（数组）",
      "group": "提取示例",
      "request": {
        "method": "GET",
        "url": "https://httpbin.org/json",
        "timeout": 30
      },
      "assert": {
        "status_code": 200,
        "json_path": {
          "slideshow.slides[0].title": "Wake up to WonderWidgets!"
        }
      },
      "extract": {
        "firstSlide": "slideshow.slides[0].title"
      },
      "extract_list": {
        "slideTitles": "slideshow.slides[*].title",
        "slides": "slideshow.slides"
      }
    },
    {
      "name": "示例5 逐条入参（对象数组→${item.字段}）",
      "group": "提取示例",
      "request": {
        "method": "GET",
        "url": "https://httpbin.org/get?title=${slide.title}&type=${slide.type}",
        "timeout": 30
      },
      "assert": {
        "status_code": 200,
        "json_path_exists": [
          "args.title",
          "args.type"
        ]
      },
      "foreach": {
        "from": "slides",
        "item": "slide"
      }
    },
    {
      "name": "示例4 逐条入参（数组→每轮一个值）",
