{
  "groups": [
    "用户模块",
    "提取示例",
    "脚本示例",
    "参数化串联"
  ],
  "name": "接口用例",
  "steps": [
    {
      "name": "创建订单",
      "request": {
        "method": "POST",
        "url": "https://httpbin.org/post"
      },
      "group": "用户模块"
    },
    {
      "group": "用户模块",
      "name": "获取用户",
      "request": {
        "method": "GET",
        "url": "https://httpbin.org/get"
      }
    },
    {
      "name": "示例1 创建订单（提取）",
      "request": {
        "method": "POST",
        "url": "https://httpbin.org/post",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "orderNo": "${orderNo}",
          "sku": "SKU-9",
          "qty": 2
        },
        "timeout": 30
      },
      "assert": {
        "status_code": 200,
        "json_path": {
          "json.orderNo": "A20261105"
        }
      },
      "extract": {
        "orderNo": "json.orderNo",
        "clientIp": "origin"
      },
      "group": "提取示例"
    },
    {
      "name": "示例2 查询订单（引用）",
      "request": {
        "method": "GET",
        "url": "https://httpbin.org/get?order_no=%24%7BorderNo%7D",
        "headers": {
          "X-Order-No": "${orderNo}",
          "X-Client-Ip": "${clientIp}"
        },
        "timeout": 30
      },
      "assert": {
        "status_code": 200,
        "json_path": {
          "args.order_no": "A20261105"
        }
      },
      "group": "提取示例"
    },
    {
      "name": "示例3 列表提取（数组）",
      "group": "提取示例",
      "request": {
        "method": "GET",
        "url": "https://httpbin.org/json",
        "timeout": 30
      },
      "assert": {
        "status_code": 200,
        "json_path": {
          "slideshow.slides[0].title": "Wake up to WonderWidgets!"
        }
      },
      "extract": {
        "firstSlide": "slideshow.slides[0].title"
      },
      "extract_list": {
        "slideTitles": "slideshow.slides[*].title",
        "slides": "slideshow.slides"
      }
    },
    {
      "name": "示例5 逐条入参（对象数组→${item.字段}）",
      "request": {
        "method": "GET",
        "url": "https://httpbin.org/get?title=${slide.title}&type=${slide.type}",
        "headers": {
          "slideTitle": "${slideTitle}",
          "slide": "${slide.title}"
        },
        "timeout": 30
      },
      "assert": {
        "status_code": 200,
        "json_path_exists": [
          "args.title",
          "args.type"
        ]
      },
      "foreach": {
        "from": "slides,slideTitles",
        "item": "slide,slideTitle"
      },
      "group": "提取示例"
    },
    {
      "name": "示例4 逐条入参（数组→每轮一个值）",
      "request": {
        "method": "GET",
        "url": "https://httpbin.org/get?slide=${slideTitle}&gift=${gift}&userName=${userName}",
        "headers": {
          "X-Slide-No": "${slideTitle}"
        },
        "timeout": 30
      },
      "assert": {
        "status_code": 200,
        "json_path_exists": [
          "args.slide"
        ]
      },
      "foreach": {
        "from": "slideTitles",
        "item": "slideTitle"
      },
      "group": "提取示例"
    },
    {
      "name": "示例1 前置改写请求 + 后置断言",
      "request": {
        "method": "GET",
        "url": "https://httpbin.org/get"
      },
      "pre_script": "// 前置脚本：请求发出前执行 —— 可以改 URL / 请求头 / 方法 / 请求体，也能读写变量\n// 1) 造一个变量：p1 是本接口脚本里能用，后面步骤里也能 ${demoTag} 引用\npm.variables.set('demoTag', 'demo-' + Date.now());\n\n// 2) 加/改请求头：upsert 表示有就覆盖、没有就新增（add 则总是新增）\npm.request.headers.upsert({ key: 'X-Demo-Tag', value: pm.variables.get('demoTag') });\n\n// 3) 改 URL（httpbin 会把收到的参数原样回显，方便看效果）\npm.request.url = pm.request.url + '?from=pre_script';\n\nconsole.log('前置脚本把 X-Demo-Tag 设成了', pm.variables.get('demoTag'));\n",
      "post_script": "// 后置脚本：请求完成后执行 —— 可以读响应、加断言、把响应里的值存成变量\nconst d = pm.response.json();\nconsole.log('状态码', pm.response.code, '· 耗时', pm.response.responseTime + 'ms');\n\n// pm.test 的结果会并进本接口的断言结果里，只要有 [FAIL] 就算这条用例失败\npm.test('状态码是 200', () => pm.expect(pm.response.code).to.equal(200));\npm.test('前置加的请求头带上了', () =>\n  pm.expect(d.headers['X-Demo-Tag'] || d.headers['x-demo-tag']).to.equal(pm.variables.get('demoTag')));\npm.test('前置改的 URL 生效了', () => pm.expect(d.args.from).to.equal('pre_script'));\n\n// 存成变量，后续步骤可以 ${origin} 引用\npm.variables.set('origin', d.origin || '');\nconsole.log('已把 origin 存成变量：', pm.variables.get('origin'));\n",
      "group": "脚本示例"
    },
    {
      "group": "脚本示例",
      "name": "示例2 后置断言并提取变量",
      "request": {
        "method": "GET",
        "url": "https://httpbin.org/json"
      },
      "post_script": "// 只写后置脚本也一样：断言响应结构 + 提取字段给后面的步骤用\nconst d = pm.response.json();\npm.test('状态码是 200', () => pm.expect(pm.response.code).to.equal(200));\npm.test('至少 2 页 slide', () => pm.expect(d.slideshow.slides.length).to.be.above(1));\n\n// 提取第一个标题：后续步骤用 ${slideTitle} 就能取到\npm.variables.set('slideTitle', d.slideshow.slides[0].title);\nconsole.log('第一页标题 =', pm.variables.get('slideTitle'));\n"
    },
    {
      "name": "① 登录（参数化入参 userName/city）",
      "group": "参数化串联",
      "request": {
        "method": "POST",
        "url": "https://httpbin.org/post",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "username": "${userName}",
          "city": "${city}",
          "pwd": "pwd-${userName}"
        },
        "timeout": 30
      },
      "assert": {
        "status_code": 200,
        "json_path_exists": [
          "json.username",
          "json.city"
        ]
      },
      "extract": {
        "loginToken": "json.username",
        "loginCity": "json.city"
      }
    },
    {
      "name": "② 下单（引用 ${loginToken} 提取订单号）",
      "group": "参数化串联",
      "request": {
        "method": "POST",
        "url": "https://httpbin.org/post",
        "headers": {
          "Content-Type": "application/json",
          "X-Token": "${loginToken}"
        },
        "body": {
          "token": "${loginToken}",
          "city": "${loginCity}",
          "orderNo": "NO-${userName}",
          "sku": "SKU-9",
          "qty": 2
        },
        "timeout": 30
      },
      "assert": {
        "status_code": 200,
        "json_path_exists": [
          "json.token",
          "json.orderNo"
        ]
      },
      "extract": {
        "orderNo": "json.orderNo",
        "skuCode": "json.sku"
      }
    },
    {
      "name": "③ 查单（引用 ${orderNo}/${skuCode} 校验传递）",
      "group": "参数化串联",
      "request": {
        "method": "GET",
        "url": "https://httpbin.org/get?orderNo=${orderNo}&token=${loginToken}&sku=${skuCode}",
        "headers": {
          "X-Token": "${loginToken}"
        },
        "timeout": 30
      },
      "assert": {
        "status_code": 200,
        "json_path": {
          "args.sku": "SKU-9"
        },
        "json_path_exists": [
          "args.orderNo",
          "args.token",
          "args.sku"
        ]
      },
      "extract": {
        "finalOrderNo": "args.orderNo"
      }
    },
    {
      "name": "店长信息获取",
      "request": {
        "method": "POST",
        "url": "http://pmslink-test.bestwehotel.net/proxy/pms-ex/sso/rest/user/searchShopManager/v1",
        "body": {
          "storeId": "WYN5180481",
          "status": 1,
          "currentPage": 1,
          "pageSize": 100
        },
        "headers": {
          "Content-Type": "application/json",
          "X-AUTH-HEADER": "JW0XRPRCPEQNCSASCK6SLKNIYUKS0NDI",
          "APP-ID": "100005",
          "fizz-appid": "pms-ex-rzt",
          "fizz-sign": "1628d359b4f64f44927e12bd50e97686"
        },
        "timeout": 60
      }
    }
  ]
}
